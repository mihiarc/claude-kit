{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git * push -uf*)",
      "Bash(git * push * -uf*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git * push --delete*)",
      "Bash(git * push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git * push -d*)",
      "Bash(git * push * -d*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git * push --mirror*)",
      "Bash(git * push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git * push --prune*)",
      "Bash(git * push * --prune*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git * push +*)",
      "Bash(git * push * +*)",
      "mcp__*__*send*",
      "mcp__*__*share*",
      "mcp__*__*trash*",
      "mcp__*__*forward*",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Resend__send-email",
      "mcp__claude_ai_Resend__share-email"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "f=\"__KIT__/extras/statusline/statusline.sh\"; [ -x \"$f\" ] && \"$f\"",
    "refreshInterval": 30
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"__KIT__/plugins/stacked-pr-guard/hooks/guard_stacked_pr_merge.py\"; [ -f \"$f\" ] || exit 0; python3 -I \"$f\"",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"__KIT__/plugins/papercuts/hooks/gotcha_hints.py\"; [ -f \"$f\" ] || exit 0; python3 -I \"$f\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"__KIT__/plugins/papercuts/hooks/gotcha_hints.py\"; [ -f \"$f\" ] || exit 0; python3 -I \"$f\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"__KIT__/plugins/papercuts/hooks/gotcha_hints.py\"; [ -f \"$f\" ] || exit 0; python3 -I \"$f\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "echo 'This conversation was just compacted. If the working directory has a CLAUDE.local.md with a Progress section, that section is the task progress record, and the file on disk is newer than any summary of it.'"
          }
        ]
      }
    ]
  }
}
