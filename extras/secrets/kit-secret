#!/usr/bin/env bash
# kit-secret: set secrets without anyone pasting them into a chat.
#
# A secret's value goes from a hidden prompt, or from the generator, straight
# into the local store (the macOS keychain, or secret-tool on Linux), and from
# there through a pipe into `gh secret set`. It is never printed, never written
# to a file, and never put in a command's arguments, where the process list
# would show it. Run `kit-secret help` for the three ways to use it.
set +x
set -euo pipefail

PROG=kit-secret

usage() {
  cat <<'EOF'
kit-secret: set secrets without pasting them into a chat.

  kit-secret save SERVICE [--account A] [--replace] [--gh NAME [gh flags]]
      A token you copied from a dashboard. Asks for it with a hidden prompt and
      saves it in the local store. Needs your own terminal: run it in a terminal
      tab, not in Claude's prompt or Claude's Bash tool.

  kit-secret gh SERVICE NAME [--account A] [gh flags]
      A value already in the local store. Reads it and pipes it to
      `gh secret set NAME`.

  kit-secret new SERVICE [--account A] [--bytes N] [--replace] [--gh NAME [gh flags]]
      A value to generate. Makes N random bytes (default 32) as hex, saves them
      in the local store and, with --gh, sets the GitHub secret from the same
      variable, so the two can't diverge.

gh flags are passed to `gh secret set`, for example --repo OWNER/REPO, --env ENV
or --app dependabot. --body, --env-file and --no-store are refused: the value
comes from the store, and only from there.

SERVICE names the item in the local store. --account defaults to $USER when
saving; when reading, an item with any account matches unless you give one.
The store is the macOS keychain on macOS and secret-tool elsewhere;
KIT_SECRET_STORE=keychain or secret-tool picks one.
EOF
}

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit "${2:-1}"; }
say() { printf '%s: %s\n' "$PROG" "$1" >&2; }

store_kind() {
  local kind="${KIT_SECRET_STORE:-}"
  if [ -z "$kind" ]; then
    if [ "$(uname -s)" = Darwin ]; then kind=keychain; else kind=secret-tool; fi
  fi
  case "$kind" in
    keychain) command -v security >/dev/null 2>&1 || die "the keychain store needs \`security\`, which is not on PATH." ;;
    secret-tool) command -v secret-tool >/dev/null 2>&1 || die "the secret-tool store needs \`secret-tool\` (libsecret-tools), which is not on PATH." ;;
    *) die "KIT_SECRET_STORE must be keychain or secret-tool, not '$kind'." ;;
  esac
  command -v perl >/dev/null 2>&1 || die "\`perl\` is not on PATH; kit-secret uses it to carry values that hold newlines or non-ASCII bytes."
  printf '%s' "$kind"
}

# cmdline ARG...: a kit-secret command, quoted so it can be pasted back into a shell.
cmdline() {
  local out=kit-secret a
  for a in "$@"; do out="$out $(printf '%q' "$a")"; done
  printf '%s' "$out"
}

describe() {  # how to name an item in a message
  if [ -n "$2" ]; then printf "'%s' (account '%s')" "$1" "$2"; else printf "'%s'" "$1"; fi
}

# store_has SERVICE ACCOUNT: exit 0 if the item exists. Never prints the value.
store_has() {
  case "$STORE" in
    keychain)
      if [ -n "$2" ]; then security find-generic-password -s "$1" -a "$2" >/dev/null 2>&1
      else security find-generic-password -s "$1" >/dev/null 2>&1; fi ;;
    secret-tool)
      if [ -n "$2" ]; then secret-tool lookup service "$1" account "$2" >/dev/null 2>&1
      else secret-tool lookup service "$1" >/dev/null 2>&1; fi ;;
  esac
}

# Values travel inside this script as lowercase hex, so newlines, tabs, NUL and
# non-ASCII bytes survive shell variables and $(...), and are decoded only in the
# pipe to gh. Perl reads and writes them on stdin and stdout, never in argv, and
# in byte mode, so PERL_UNICODE or PERL5OPT=-CS in the environment can't re-encode them.
HEX_ENCODE='binmode STDIN; binmode STDOUT; local $/; my $s = <STDIN>; print unpack("H*", defined $s ? $s : "")'
HEX_DECODE='binmode STDIN; binmode STDOUT; local $/; my $s = <STDIN>; print pack("H*", defined $s ? $s : "")'
# `security -w` prints a value raw when every byte is printable and as bare hex
# otherwise, so "deadbeef" could be either. `-g` marks hex with 0x (and also uses
# hex for a backslash):
#   password: "raw value"      or      password: 0xHEX  "escaped"
KEYCHAIN_G_TO_HEX='binmode STDIN; binmode STDOUT; local $/; my $s = <STDIN>; $s = "" unless defined $s;
  if ($s =~ /^password: 0x([0-9A-Fa-f]*)/m) { print lc $1; exit 0 }
  if ($s =~ /^password: "(.*)"$/m) { print unpack("H*", $1); exit 0 }
  if ($s =~ /^password: *$/m) { exit 0 }
  exit 3'

# store_read_hex SERVICE ACCOUNT: prints the value as hex. Only ever called inside $(...).
store_read_hex() {
  case "$STORE" in
    keychain)
      # -g writes the password line to stderr and the attributes to stdout.
      if [ -n "$2" ]; then security find-generic-password -s "$1" -a "$2" -g 2>&1 >/dev/null
      else security find-generic-password -s "$1" -g 2>&1 >/dev/null; fi | perl -e "$KEYCHAIN_G_TO_HEX" ;;
    secret-tool)
      # secret-tool adds a newline only when stdout is a terminal, which here it never is.
      if [ -n "$2" ]; then secret-tool lookup service "$1" account "$2"
      else secret-tool lookup service "$1"; fi | perl -e "$HEX_ENCODE" ;;
  esac
}

# store_write_tty SERVICE ACCOUNT: the store's own hidden prompt asks for the value.
store_write_tty() {
  case "$STORE" in
    # -w last with no value: security prompts twice, without echo.
    keychain) security add-generic-password -U -a "$2" -s "$1" -l "$1" -w ;;
    secret-tool) secret-tool store --label="$1" service "$1" account "$2" ;;
  esac
}

# store_write_stdin SERVICE ACCOUNT: the value arrives on stdin (hex only).
store_write_stdin() {
  local v
  v=$(cat)
  case "$v" in *[!0-9a-f]*|'') die "internal: store_write_stdin takes hex only." ;; esac
  case "$STORE" in
    # security -i reads the command from stdin, so the value stays out of argv.
    # Service and account were checked to hold no quote, backslash or newline.
    keychain) printf 'add-generic-password -U -a "%s" -s "%s" -l "%s" -w %s\n' "$2" "$1" "$1" "$v" \
                | security -i >/dev/null ;;
    secret-tool) printf '%s' "$v" | secret-tool store --label="$1" service "$1" account "$2" ;;
  esac
}

check_name() {  # $1 what, $2 value
  case "$2" in
    '') die "$1 is empty." ;;
    -*) die "$1 '$2' starts with '-'; put it first, before the options." ;;
    *[\"\\\'$'\n'$'\t']*) die "$1 may not hold quotes, backslashes, tabs or newlines." ;;
  esac
}

check_gh_flags() {
  local a
  for a in "$@"; do
    case "$a" in
      --body|--body=*|--env-file|--env-file=*|--no-store)
        die "$a is refused: the value comes from the local store, and only from there." 2 ;;
      --*) ;;
      # A short-flag cluster such as -ub or -uf would reach gh as --body or --env-file.
      -*[bf]*)
        die "$a is refused: a short flag holding b or f could be gh's -b (--body) or -f (--env-file), and the value comes from the local store, and only from there. Use long flags, such as --env NAME." 2 ;;
    esac
  done
  command -v gh >/dev/null 2>&1 || die "\`gh\` is not on PATH; install the GitHub CLI and run \`gh auth login\`."
}

# push SERVICE ACCOUNT NAME [gh flags]: read from the store, pipe to gh.
# PUSH_FAIL_HINT, when set, is added to the message if gh fails.
PUSH_FAIL_HINT=''
push() {
  local service="$1" account="$2" name="$3" hex save_args
  shift 3
  if ! store_has "$service" "$account"; then
    save_args=(save "$service")
    [ -z "$account" ] || save_args+=(--account "$account")
    save_args+=(--gh "$name" "$@")
    die "no secret $(describe "$service" "$account") in the $STORE store. Nothing was set. Save it first, in your own terminal: $(cmdline "${save_args[@]}")"
  fi
  hex=$(store_read_hex "$service" "$account") || die "could not read $(describe "$service" "$account") from the $STORE store. Nothing was set."
  [ -n "$hex" ] || die "$(describe "$service" "$account") is empty in the $STORE store. Nothing was set."
  # printf is a shell builtin and perl decodes on its stdin, so the value never
  # appears in the process list.
  if ! printf '%s' "$hex" | perl -e "$HEX_DECODE" | gh secret set "$name" "$@"; then
    hex=''
    die "gh secret set $name failed (see gh's message above).${PUSH_FAIL_HINT:+ $PUSH_FAIL_HINT}"
  fi
  hex=''
  say "set GitHub secret $name from $(describe "$service" "$account")."
}

clear_clipboard_if_holds() {  # SERVICE ACCOUNT
  command -v pbpaste >/dev/null 2>&1 && command -v pbcopy >/dev/null 2>&1 || return 0
  local clip v
  clip=$(pbpaste 2>/dev/null | perl -e "$HEX_ENCODE") || return 0
  [ -n "$clip" ] || return 0
  v=$(store_read_hex "$1" "$2" 2>/dev/null) || return 0
  # A pasted value loses the clipboard's trailing newline, so compare without it.
  if [ "$clip" = "$v" ] || [ "$clip" = "${v}0a" ]; then
    printf '' | pbcopy
    say "cleared the clipboard, which held the secret."
  fi
  clip=''; v=''
}

cmd_save() {
  local service="" account="${USER:-}" account_given="" replace="" ghname="" ghflags=() again
  [ $# -ge 1 ] || die "usage: kit-secret save SERVICE [--account A] [--replace] [--gh NAME [gh flags]]" 2
  service="$1"; shift
  check_name SERVICE "$service"
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) [ $# -ge 2 ] || die "--account needs a value." 2; account="$2"; account_given=1; shift 2 ;;
      --replace) replace=1; shift ;;
      --gh) [ $# -ge 2 ] || die "--gh needs a secret NAME." 2; ghname="$2"; shift 2; ghflags=("$@"); break ;;
      *) die "unknown option '$1' for save." 2 ;;
    esac
  done
  check_name ACCOUNT "$account"
  if [ ! -t 0 ] || [ ! -t 2 ]; then
    again=(save "$service")
    [ -z "$account_given" ] || again+=(--account "$account")
    [ -z "$replace" ] || again+=(--replace)
    [ -z "$ghname" ] || again+=(--gh "$ghname" ${ghflags[@]+"${ghflags[@]}"})
    die "save asks for the value with a hidden prompt, so it needs your own terminal, and this one has none (a \`!\` command in Claude's prompt and Claude's Bash tool both run without one). Open a terminal tab and run: $(cmdline "${again[@]}")" 2
  fi
  [ -z "$ghname" ] || { check_name NAME "$ghname"; check_gh_flags ${ghflags[@]+"${ghflags[@]}"}; }
  STORE=$(store_kind)
  if [ -z "$replace" ] && store_has "$service" "$account"; then
    die "$(describe "$service" "$account") is already in the $STORE store. Nothing was changed. Add --replace to overwrite it." 1
  fi
  say "paste the value for $(describe "$service" "$account"); it will not show as you type."
  store_write_tty "$service" "$account" || die "the $STORE store did not save $(describe "$service" "$account")."
  store_has "$service" "$account" || die "the $STORE store did not save $(describe "$service" "$account")."
  say "saved $(describe "$service" "$account") in the $STORE store."
  # Clear the clipboard only now that the write has succeeded.
  clear_clipboard_if_holds "$service" "$account"
  if [ -n "$ghname" ]; then
    PUSH_FAIL_HINT="The $STORE store now holds the new value and GitHub does not, so the two differ. Retry with: $(cmdline gh "$service" "$ghname" --account "$account" ${ghflags[@]+"${ghflags[@]}"})"
    push "$service" "$account" "$ghname" ${ghflags[@]+"${ghflags[@]}"}
  fi
}

cmd_gh() {
  local service="" account="" name="" ghflags=()
  [ $# -ge 2 ] || die "usage: kit-secret gh SERVICE NAME [--account A] [gh flags]" 2
  service="$1"; name="$2"; shift 2
  check_name SERVICE "$service"; check_name NAME "$name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) [ $# -ge 2 ] || die "--account needs a value." 2; account="$2"; check_name ACCOUNT "$account"; shift 2 ;;
      *) ghflags+=("$1"); shift ;;
    esac
  done
  check_gh_flags ${ghflags[@]+"${ghflags[@]}"}
  STORE=$(store_kind)
  push "$service" "$account" "$name" ${ghflags[@]+"${ghflags[@]}"}
}

cmd_new() {
  local service="" account="${USER:-}" bytes=32 replace="" ghname="" ghflags=() v
  [ $# -ge 1 ] || die "usage: kit-secret new SERVICE [--account A] [--bytes N] [--replace] [--gh NAME [gh flags]]" 2
  service="$1"; shift
  check_name SERVICE "$service"
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) [ $# -ge 2 ] || die "--account needs a value." 2; account="$2"; shift 2 ;;
      --bytes) [ $# -ge 2 ] || die "--bytes needs a number." 2; bytes="$2"; shift 2 ;;
      --replace) replace=1; shift ;;
      --gh) [ $# -ge 2 ] || die "--gh needs a secret NAME." 2; ghname="$2"; shift 2; ghflags=("$@"); break ;;
      *) die "unknown option '$1' for new." 2 ;;
    esac
  done
  check_name ACCOUNT "$account"
  case "$bytes" in ''|*[!0-9]*) die "--bytes must be a whole number." 2 ;; esac
  [ "$bytes" -ge 16 ] && [ "$bytes" -le 256 ] || die "--bytes must be between 16 and 256." 2
  [ -z "$ghname" ] || { check_name NAME "$ghname"; check_gh_flags ${ghflags[@]+"${ghflags[@]}"}; }
  command -v openssl >/dev/null 2>&1 || die "\`openssl\` is not on PATH; it generates the value."
  STORE=$(store_kind)
  if [ -z "$replace" ] && store_has "$service" "$account"; then
    die "$(describe "$service" "$account") is already in the $STORE store. Nothing was changed. Add --replace to overwrite it." 1
  fi
  v=$(openssl rand -hex "$bytes") || die "openssl could not generate a value."
  case "$v" in *[!0-9a-f]*|'') die "openssl gave an unexpected value; nothing was saved." ;; esac
  # The store is the source; GitHub gets the same variable.
  printf '%s' "$v" | store_write_stdin "$service" "$account" \
    || { v=''; die "the $STORE store did not save $(describe "$service" "$account"). Nothing was set."; }
  store_has "$service" "$account" || { v=''; die "the $STORE store did not save $(describe "$service" "$account"). Nothing was set."; }
  say "generated $bytes random bytes and saved them as $(describe "$service" "$account") in the $STORE store."
  if [ -n "$ghname" ]; then
    if ! printf '%s' "$v" | gh secret set "$ghname" ${ghflags[@]+"${ghflags[@]}"}; then
      v=''
      die "saved in the $STORE store, but gh secret set $ghname failed (see gh's message above), so the two differ. Retry with: $(cmdline gh "$service" "$ghname" --account "$account" ${ghflags[@]+"${ghflags[@]}"})"
    fi
    say "set GitHub secret $ghname from the same value."
  fi
  v=''
}

main() {
  [ $# -ge 1 ] || { usage >&2; exit 2; }
  local cmd="$1"; shift
  case "$cmd" in
    save) cmd_save "$@" ;;
    gh) cmd_gh "$@" ;;
    new) cmd_new "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command '$cmd'." 2 ;;
  esac
}

main "$@"
